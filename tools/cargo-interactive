#!/usr/bin/env bash
set -euo pipefail

# Keep compile-heavy work off half of the physical CPU cores so the desktop,
# game client, and other interactive processes retain real execution resources.
# Override when needed, for example: CF_BUILD_CPUS=0-11 tools/cargo-interactive check
choose_build_cpus() {
    if [[ -n "${CF_BUILD_CPUS:-}" ]]; then
        printf '%s\n' "$CF_BUILD_CPUS"
        return
    fi

    local topology_dir=/sys/devices/system/cpu
    local sibling_file
    local -a sibling_sets=()

    while IFS= read -r sibling_file; do
        sibling_sets+=("$(<"$sibling_file")")
    done < <(find "$topology_dir" -path '*/topology/thread_siblings_list' -type f -print 2>/dev/null | sort -V)

    if ((${#sibling_sets[@]} == 0)); then
        # taskset accepts this on any machine with CPU 0; this is only a fallback
        # for unusual environments without Linux CPU topology information.
        printf '0\n'
        return
    fi

    # thread_siblings_list is identical for every SMT sibling, so deduplicate it
    # into physical cores while preserving CPU order.
    local -a physical_cores=()
    local -A seen_cores=()
    local siblings
    for siblings in "${sibling_sets[@]}"; do
        if [[ -z "${seen_cores[$siblings]:-}" ]]; then
            physical_cores+=("$siblings")
            seen_cores[$siblings]=1
        fi
    done

    local keep=$(( ${#physical_cores[@]} / 2 ))
    ((keep < 1)) && keep=1

    local cpu_list=""
    local i
    for ((i = 0; i < keep; i++)); do
        [[ -n "$cpu_list" ]] && cpu_list+=","
        cpu_list+="${physical_cores[$i]}"
    done
    printf '%s\n' "$cpu_list"
}

if ! command -v taskset >/dev/null 2>&1; then
    exec cargo "$@"
fi

build_cpus="$(choose_build_cpus)"
build_nice="${CF_BUILD_NICE:-10}"

resolve_target_dir() {
    local target_dir=""
    local arg

    # A command-line target dir overrides CARGO_TARGET_DIR. Stop at -- so a
    # program argument named --target-dir is not mistaken for Cargo's option.
    while (($# > 0)); do
        arg="$1"
        case "$arg" in
            --)
                break
                ;;
            --target-dir=*)
                target_dir="${arg#--target-dir=}"
                ;;
            --target-dir)
                shift
                if (($# == 0)); then
                    break
                fi
                target_dir="$1"
                ;;
        esac
        shift
    done

    if [[ -z "$target_dir" ]]; then
        target_dir="${CARGO_TARGET_DIR:-}"
    fi
    if [[ -z "$target_dir" ]]; then
        target_dir="$(git rev-parse --show-toplevel 2>/dev/null || pwd)/target"
    elif [[ "$target_dir" != /* ]]; then
        target_dir="$(pwd)/$target_dir"
    fi

    printf '%s\n' "$target_dir"
}

repair_stale_rustc_info() {
    command -v sccache >/dev/null 2>&1 || return 0

    local target_dir
    local rustc_info
    local rustc=""

    target_dir="$(resolve_target_dir "$@")"
    rustc_info="$target_dir/.rustc_info.json"
    [[ -f "$rustc_info" ]] || return 0

    # Cargo can persist a transient rustc-wrapper failure here and replay it on
    # every later invocation without consulting the wrapper again. Only repair
    # the exact sandbox-style sccache failure we have observed, and only when a
    # fresh direct wrapper probe now succeeds.
    grep -Fq '"success":false' "$rustc_info" || return 0
    grep -Fq 'sccache: error: Operation not permitted (os error 1)' "$rustc_info" || return 0

    if [[ -n "${RUSTC:-}" ]]; then
        rustc="$RUSTC"
    elif command -v rustup >/dev/null 2>&1; then
        rustc="$(rustup which rustc 2>/dev/null || true)"
    fi
    if [[ -z "$rustc" ]]; then
        rustc="$(command -v rustc 2>/dev/null || true)"
    fi
    [[ -n "$rustc" ]] || return 0

    if sccache "$rustc" -vV >/dev/null 2>&1; then
        rm -f -- "$rustc_info"
        printf 'cargo-interactive: removed stale Cargo rustc probe cache after a successful sccache probe\n' >&2
    fi
}

# The default 10 GiB sccache store is too small for Bevy plus several active
# worktrees/profiles and was observed sitting at its eviction ceiling. This is a
# maximum, not a reservation; callers can override it when disk is constrained.
export SCCACHE_CACHE_SIZE="${SCCACHE_CACHE_SIZE:-32G}"

# sccache's default 600-second idle timeout can fire while long rustc jobs are
# still running. Disable idle shutdown so those jobs keep their server
# connection instead of falling back to duplicate local compilation.
export SCCACHE_IDLE_TIMEOUT="${SCCACHE_IDLE_TIMEOUT:-0}"

# sccache is a long-lived daemon and launches rustc itself. Constraining only
# Cargo is therefore insufficient: pin the daemon as well so current and future
# rustc children inherit the same CPU affinity.
if command -v sccache >/dev/null 2>&1; then
    taskset --cpu-list "$build_cpus" sccache --start-server >/dev/null 2>&1 || true
    while IFS= read -r pid; do
        [[ -z "$pid" ]] && continue
        taskset --all-tasks --pid --cpu-list "$build_cpus" "$pid" >/dev/null 2>&1 || true
    done < <(pgrep -u "$(id -u)" -x sccache 2>/dev/null || true)
fi

# Multiple six-job Cargo builds pinned to the same CPU set just oversubscribe
# those CPUs and make every build dramatically slower. Serialize compile-heavy
# invocations across CF Native worktrees by default. Builds are expected to run
# asynchronously, so waiting here is preferable to several builds timing out
# while fighting over the same cores. Set CF_BUILD_SERIALIZE=0 to opt out.
if [[ "${CF_BUILD_SERIALIZE:-1}" != "0" ]] && command -v flock >/dev/null 2>&1; then
    build_lock="${XDG_RUNTIME_DIR:-/tmp}/castle-fight-native-cargo-${UID}.lock"
    exec 9>"$build_lock"
    if ! flock -n 9; then
        printf 'cargo-interactive: waiting for the active Castle Fight build to finish...\n' >&2
        flock 9
    fi
fi

repair_stale_rustc_info "$@"

exec taskset --cpu-list "$build_cpus" nice -n "$build_nice" ionice -c 2 -n 7 cargo "$@"
